# Massar Services - Apache configuration for the static site
# Requires Apache 2.4+ with mod_rewrite, mod_headers and mod_expires.
# This file is copied to the web root by the build.

Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash On
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
ServerSignature Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical origin: HTTPS, no www.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://massarservices.ma%{REQUEST_URI} [R=301,L]

  # Never serve directory listings for generated folders.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_alias.c>
  # Legacy and merged URLs from the previous WordPress site.
  RedirectMatch 301 ^/about-us/?$ /من-نحن/
  RedirectMatch 301 ^/contact-us/?$ /اتصل-بنا/
  RedirectMatch 301 ^/faq/?$ /الأسئلة-الشائعة/
  RedirectMatch 301 ^/privacy-policy/?$ /سياسة-الخصوصية/
  RedirectMatch 301 ^/terms/?$ /شروط-الاستخدام/
  RedirectMatch 301 ^/disclaimer/?$ /إخلاء-المسؤولية/
  RedirectMatch 301 ^/reset-massar-password/?$ /استرجاع-كلمة-المرور/
  RedirectMatch 301 ^/exam-results/?$ /نتائج-مسار/
  RedirectMatch 301 ^/نتائج-الامتحانات/?$ /نتائج-مسار/
  RedirectMatch 301 ^/مسار-2026/?$ /التقويم-المدرسي/
  RedirectMatch 301 ^/massar-problems/?$ /مشاكل-مسار/
  RedirectMatch 301 ^/guides/?$ /شروحات/
  RedirectMatch 301 ^/en/exam-results/?$ /en/massar-results/
  RedirectMatch 301 ^/en/الأسئلة-الشائعة/?$ /en/faq/

  # Retired WordPress feeds and sitemap endpoints.
  RedirectMatch 301 ^/sitemap_index\.xml$ /sitemap.xml
  RedirectMatch 301 ^/wp-sitemap\.xml$ /sitemap.xml
  RedirectMatch 301 ^/feed/?$ /أخبار-التعليم/
  RedirectMatch 301 ^/en/feed/?$ /en/education-news/

  # Private data and internal PHP libraries are never served.
  RedirectMatch 404 ^/(storage|lib)(/|$)
</IfModule>

# ---------------------------------------------------------------- security
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # 'unsafe-inline' is required for the per-page JSON-LD blocks. No third-party
  # scripts are loaded. If Google Analytics is enabled in src/data/site.json,
  # extend script-src, img-src and connect-src accordingly.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src 'none'; upgrade-insecure-requests"
</IfModule>

# ---------------------------------------------------------------- caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hours"
  ExpiresByType text/plain "access plus 1 hours"
  ExpiresByType application/json "access plus 1 hours"
  ExpiresByType application/manifest+json "access plus 1 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# ---------------------------------------------------------------- file access
<FilesMatch "\.(md|ps1|log|ini|bak|sql|env|sh|yml|yaml)$">
  Require all denied
</FilesMatch>

# Database files and per-install secrets.
<FilesMatch "\.(sqlite|sqlite3|db|db3)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(bootstrap|config\.local|config)\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<Files ".htaccess">
  Require all denied
</Files>

<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .json .xml .txt .webmanifest
</IfModule>
