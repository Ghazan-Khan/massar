# Massar Services - private storage
#
# This directory holds the SQLite database (massar.sqlite), its secret key and
# the schema. Nothing here is meant to be served over HTTP.
#
# Apache 2.4
Require all denied

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
