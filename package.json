{
  "name": "massarservices-site",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual static website for Massar Services (massarservices.ma). No npm dependencies: pages are generated by Windows PowerShell scripts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ghazan-Khan/massar.git"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1",
    "serve": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1"
  }
}
